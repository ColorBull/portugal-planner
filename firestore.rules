rules_version = '2';

// Every trip lives under trips/{tripId} (with days/, notes/ and photos/
// sub-collections). Only the trip participants —
// identified by their verified Google e-mail — can read or write anything
// beneath it. Keep this list identical to ALLOWED_EMAILS in src/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isParticipant() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'yoffedani@gmail.com',
          'yoffeleonid@gmail.com',
          'yoffelena@gmail.com'
        ];
    }

    // NOTE: under rules_version 2 a recursive wildcard matches ONE or more
    // segments, so {document=**} alone does NOT cover the trips/{tripId}
    // document itself. The trip docs need their own match block — without it
    // listing trips and opening one is denied.
    // Only the trip's creator (created_by) may set or remove its PIN lock, and
    // nobody may rewrite who the creator is. See src/lib/tripLock.js.
    function ownerOnlyFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['pin_hash', 'locked_date', 'created_by']);
    }

    function isOwner() {
      return request.auth.token.email == resource.data.get('created_by', '');
    }

    match /trips/{tripId} {
      allow read, create, delete: if isParticipant();
      allow update: if isParticipant()
        && (ownerOnlyFieldsUntouched()
            || (isOwner() && request.resource.data.get('created_by', '') == resource.data.get('created_by', '')));

      match /{document=**} {
        allow read, write: if isParticipant();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
