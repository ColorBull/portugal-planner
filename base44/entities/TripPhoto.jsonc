{
  "name": "TripPhoto",
  "type": "object",
  "properties": {
    "day_key": {
      "type": "string",
      "description": "\u041a\u043b\u044e\u0447 \u0434\u043d\u044f, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0437\u0430\u043f\u0438\u0441\u044c (\u043d\u0430\u043f\u0440. 2026-10-30)"
    },
    "item_id": {
      "type": "string",
      "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0443\u043d\u043a\u0442\u0430 \u043f\u043b\u0430\u043d\u0430, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d \u0444\u0430\u0439\u043b"
    },
    "photo_url": {
      "type": "string",
      "description": "URL \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0430 (\u0444\u043e\u0442\u043e \u0438\u043b\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "photo",
        "document"
      ],
      "default": "photo",
      "description": "\u0422\u0438\u043f \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0430"
    },
    "file_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0444\u0430\u0439\u043b\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 (\u0434\u043b\u044f \u0444\u043e\u0442\u043e \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f)"
    },
    "caption": {
      "type": "string",
      "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u044c (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"
